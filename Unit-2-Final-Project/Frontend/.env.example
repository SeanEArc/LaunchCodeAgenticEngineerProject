# Base URL of the Round 1 backend. Leave unset to use the local default
# (http://localhost:8080). Copy this file to .env.local to override it.
#
# No secrets belong in this file: the session lives in an HttpOnly cookie set by
# the backend, and the CSRF token is fetched at runtime from GET /auth/csrf.
VITE_API_URL=http://localhost:8080
