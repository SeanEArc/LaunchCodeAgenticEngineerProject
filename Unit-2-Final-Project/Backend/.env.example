# Backend environment variables - Round 1.
# Copy to a file your shell sources, or export these directly.
# Placeholders only: do not commit real values.

# --- Database -------------------------------------------------------------
# Provision once:  createdb -U postgres fitness_round1_dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/fitness_round1_dev
SPRING_DATASOURCE_USERNAME=postgres
# Required. No default; the backend will not start without it.
SPRING_DATASOURCE_PASSWORD=<your-local-postgres-password>

# --- CORS -----------------------------------------------------------------
# Comma-separated. Must match the browser's address bar exactly.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Session / cookie -----------------------------------------------------
# Default is the required 30 minutes of inactivity. Only shorten it
# temporarily when checking expiry handling, then restore it.
APP_SESSION_TIMEOUT=30m
# Leave false for local HTTP. Set true only when served over HTTPS.
APP_SESSION_COOKIE_SECURE=false
APP_SESSION_COOKIE_SAME_SITE=Lax

# --- Server ---------------------------------------------------------------
SERVER_PORT=8080
